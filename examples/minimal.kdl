// Minimal dotbar style: session on the left, tabs centered with dot separators,
// time on the right. Near-zero visual footprint — no icons, no backgrounds.
//
// Visual layout:
//   Left:   ■  mysession
//   Center: tab1 • tab2 • tab3
//   Right:  21:00

plugins {
    zellij-hud location="file:~/repos/zellij/zellij-hud/target/wasm32-wasip1/release/zellij-hud.wasm" {

        // === Global ===
        theme "system"

        // === Layout ===
        format_left   "{mode} {session}"
        format_center "{tabs}"
        format_right  "{time}"
        bar_bg ""

        // === Mode widget ===
        // Compact accent-colored block reflecting current mode.
        mode_fg     "accent"
        mode_bg     ""
        mode_attr   ""
        mode_content_normal      "■"
        mode_content_locked      "■"
        mode_content_pane        "■"
        mode_content_tab         "■"
        mode_content_resize      "■"
        mode_content_move        "■"
        mode_content_scroll      "■"
        mode_content_search      "■"
        mode_content_enter_search "■"
        mode_content_rename_tab  "■"
        mode_content_rename_pane "■"
        mode_content_session     "■"
        mode_content_prompt      "■"
        mode_content_tmux        "■"
        mode_format " {content}"

        // === Session widget ===
        session_fg     "dim"
        session_bg     ""
        session_attr   ""
        session_format " {name} "

        // === Tab widgets ===
        // Dot separator between tabs, brighter for the active one.
        tab_active_fg   "fg"
        tab_active_bg   ""
        tab_active_attr "bold"
        tab_active_format "{name}"

        tab_inactive_fg   "dim"
        tab_inactive_bg   ""
        tab_inactive_attr ""
        tab_inactive_format "{name}"

        tab_separator " • "

        // === Time (command widget) ===
        time_fg     "dim"
        time_bg     ""
        time_attr   ""
        time_format " {stdout} "
    }
}

load_plugins {
    "zellij-hud"
}
